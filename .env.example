# Copy this file to `.env` and fill in the values from your own Supabase project
# (Supabase dashboard -> Project Settings -> API).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The "anon" (a.k.a. publishable) key. It is designed to be shipped to the
# browser: what a visitor can read or write is enforced by the row-level
# security policies in supabase/migrations, not by keeping this key secret.
# NEVER put the service_role key here - it bypasses RLS and would be public.
VITE_SUPABASE_ANON_KEY=
